# Build / test outputs.
test-logs/
nim-cache/
bench-results/

# direnv local state.
.direnv/

# Compiled test binaries (Justfile + per-test compile output).
tests/test_*
!tests/test_*.nim
!tests/test_*.cfg

# Compiled example binaries (each examples/<name>/<name> matching its dir name).
examples/calculator/calculator
examples/code_browser/code_browser
examples/datatable_demo/datatable_demo
examples/dictionary/dictionary
examples/log_viewer/log_viewer
examples/markdown_viewer/markdown_viewer
examples/system_monitor/system_monitor
examples/task_app_demo/task_app_demo

# M29 real-terminal scenario binaries (one per scenario file).
tests/real_terminal/test_real_*
!tests/real_terminal/test_real_*.nim
# M29 per-widget test app binaries (each apps/<name> stripped of extension).
tests/real_terminal/apps/*
!tests/real_terminal/apps/*.nim
!tests/real_terminal/apps/*.nims

# Nim caches.
*.dSYM
*.exe
*.pdb
src/isonim_tui/syntax/highlighter
src/isonim_tui/syntax/treesitter_ffi
tests/snapshots/_report.html

# Built by the `grammars` recipe: the two tree-sitter grammars archived
# into one static library that treesitter_ffi.nim links.
build/grammars/

# Built by `just test-real-agent-hmr` (NH-M4): the HCR agent libraries, the
# coordinator, the patchable target binaries, the recompiled patch objects and
# each arm's logs. All disposable; all rebuilt by the recipe.
build/nhm4-real-agent/
build/nimcache/

# Repro development environment cache
.repro/
# Per-checkout nimcache (config.nims): every Nim compile in this checkout
# keeps its intermediate files here, never in the shared ~/.cache/nim.
.nimcache/

# The pre-commit config is GENERATED and must not be tracked -- it is a symlink
# to an absolute /nix/store path valid only on the machine that generated it.
# git-hooks.nix writes it from the devShell shellHook on every entry.
#
# It WAS tracked here (git mode 120000), which is how a dangling symlink came to
# be checked in: `pre-commit` answers "InvalidConfigError:
# .pre-commit-config.yaml is not a file" for it off its build host, and on
# Windows it is a text file naming a path that does not exist.
#
# REMOVE THIS LINE if this repo ever adopts the portable committed form from
# repo-requirements.md section 4.1 -- a real committed config must be tracked,
# and an ignore line left behind is what made that form impossible in a sibling
# repo.
.pre-commit-config.yaml
