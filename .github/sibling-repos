# Cross-repo siblings cloned by setup-dev-env at workspace-lock-pinned
# revisions (see codetracer-specs/Testing/Cross-Repo-CI-Integration.md).
#
# This list is the set of `--path:../<repo>/...` entries the Justfile's
# `src-paths` / `real-terminal-paths` and `config.nims` actually resolve.
# CI cloned none of them (bare `actions/checkout@v4`), which is why `just
# lint` produced tens of thousands of "cannot open file" errors and still
# reported success -- the recipes pipe into `tee` and just's default shell
# had no pipefail.

isonim
isonim-examples
nim-everywhere
nim-pty
nim-termctl

# `isonim-examples/task_app/tui/leaves.nim` imports
# `isonim_render_serve/element_tree_attrs`, so every test that reaches the
# shared task-app demo needs this one too.
isonim-render-serve

# Transitive deps isonim re-exports; `src-paths` and `config.nims` both
# list them and this file did not.
nim-faststreams
nim-stew

# `real-terminal-paths` (the M29 `just test-real-terminal` /
# `just test-cross-emulator` lanes) adds these three.
nim-libvterm
TermAssert
TermAssertClient

# tree-sitter grammars for the M19 TextArea highlighter.
# `src/isonim_tui/syntax/treesitter_ffi.nim` `{.compile.}`s each grammar's
# `parser.c` / `scanner.c`; it used to reach them through
# `codetracer/libs/tree-sitter-{nim,aiken}` -- codetracer's submodule copies
# -- which no `.github/sibling-repos` declared anywhere in the org, so the
# directive could never resolve on a runner.
#
# Pinned to explicit revisions rather than resolved from the workspace lock,
# for the same reason io-mon pins nim-shm-gset: neither grammar is a project
# in the isonim workspace manifest, so a bare entry would fail resolution
# instead of cloning. These two SHAs are exactly what codetracer's
# `libs/tree-sitter-nim` / `libs/tree-sitter-aiken` submodules record, so the
# highlighter compiles against the same grammar bytes codetracer's own parser
# bridge does. The durable fix is to add both to the isonim manifest so they
# are locked alongside their siblings; these pins should be dropped then.
#
# NOTE: tree-sitter-nim does NOT ship `src/parser.c` -- it is gitignored and
# generated by `tree-sitter generate`. The `grammars` Justfile recipe runs
# that step; every nim-invoking recipe depends on it.
tree-sitter-nim=89d44d5fd3acb2d4d904b0c716654afa0898f00d
tree-sitter-aiken=ee7072a2509151d370ba27bdeb51b9e885a4ca3f
